// =============================================================================
// Nomi, Cose, Città — REGOLE FIRESTORE PROPOSTE (NON distribuite)
// =============================================================================
//
// STATO ATTUALE DEL PROGETTO
//   Nel repository non esiste alcun file di regole attivo: FaW gira su
//   Firestore senza regole restrittive lato server. Questo file e' una
//   PROPOSTA. Per attivarla servirebbe `firebase deploy --only firestore:rules`
//   su un progetto inizializzato: operazione fuori scope e non eseguibile qui
//   (nessuna Firebase CLI, nessun Emulator Suite installato).
//
// ⚠ NON DISTRIBUIRE QUESTE REGOLE COSI' COME SONO
//   Contengono clausole `[RICHIEDE AUTH]` basate su `request.auth`. FaW NON
//   usa Firebase Auth (l'identita' e' `localStorage.mioNome`), quindi
//   `request.auth` e' sempre null: quelle clausole DENIEREBBERO le scritture
//   legittime e bloccherebbero il gioco. Prima va introdotto Firebase Auth
//   (decisione che spetta al progetto, non a questo gioco), oppure vanno
//   rimosse — ma rimuoverle equivale a non avere alcuna protezione di
//   ownership. Nel frattempo hanno valore di contratto documentato.
//
// COSA E' DAVVERO VERIFICABILE SENZA AUTH
//   La forma dei documenti, la direzione delle transizioni di fase, la
//   versione di fase, l'append-only degli esiti, l'immutabilita' del quorum di
//   round e l'assenza di campi fuori contratto. Cio' che NON lo e': chi sta
//   scrivendo (quindi ownership, voto personale, segretezza delle risposte).
//
// VINCOLO DI PROGETTO
//   Zero runTransaction e zero BatchGetDocuments, anche qui: nessuna regola
//   usa get() su altri documenti. Ogni verifica confronta il documento
//   precedente (`resource`) con quello proposto (`request.resource`), cioe'
//   "fase/versione precedente → successiva".
//
// Le clausole sono state confrontate a mano con gli update prodotti da ogni
// mutatore di js/core.js (mutReady, mutStart, mutStop, mutTimeoutCompilazione,
// mutVota, mutConfermaRevisione, mutChiudiRevisione, mutProssimoRound):
// nessuna transizione legittima deve essere respinta. Vedi la checklist in
// fondo per la verifica eseguibile.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helper

    function stringa(v, max) { return v is string && v.size() <= max; }
    function intero(v, min, max) { return v is int && v >= min && v <= max; }

    function faseOk(f) { return f in ['compilazione', 'revisione', 'risultati']; }

    // `round` e `risultati` non esistono nel documento appena creato dall'hub.
    function rnd(d)   { return ('round' in d && d.round is int) ? d.round : 0; }
    function arr(d, k) { return (k in d && d[k] is list) ? d[k] : []; }

    // Le uniche chiavi di roundData che il gioco scrive.
    function chiaviRoundOk(rd) {
      return rd.keys().hasOnly([
        'id', 'round', 'lettera', 'categorie', 'partecipanti', 'fase',
        'faseVersion', 'inizio', 'deadline', 'stop', 'voti', 'conferme',
        'esitoId', 'dictVersion', 'annullateManuali'
      ]);
    }

    function roundCoerente(rd) {
      return chiaviRoundOk(rd)
        && rd.id == 'r' + string(rd.round)
        && intero(rd.round, 1, 10)
        && faseOk(rd.fase)
        && intero(rd.faseVersion, 1, 40)
        && rd.categorie is list && rd.categorie.size() >= 1 && rd.categorie.size() <= 10
        && rd.partecipanti is list && rd.partecipanti.size() >= 1 && rd.partecipanti.size() <= 8;
    }

    // ---------------------------------------------------------------- partita

    match /partite/{matchId} {

      function isNcc(d) { return d.gioco == 'ncc'; }

      // LETTURA ai soli partecipanti. [RICHIEDE AUTH]
      // Senza Auth non c'e' identita' da confrontare: oggi il documento e'
      // leggibile da chi ne conosce l'id (come per gli altri giochi FaW).
      allow read: if resource != null
                  && isNcc(resource.data)
                  && request.auth != null
                  && arr(resource.data, 'partecipanti').hasAny([request.auth.token.nome]);

      // CREAZIONE: la fa l'hub (nessun roundData, stato 'attesa').
      allow create: if request.resource.data.gioco == 'ncc'
                    && request.resource.data.stato == 'attesa'
                    && arr(request.resource.data, 'partecipanti').size() >= 1
                    && arr(request.resource.data, 'partecipanti').size() <= 8
                    && !('roundData' in request.resource.data);

      allow delete: if false;

      // ------------------------------------------------------- aggiornamento
      allow update: if isNcc(resource.data)

        // (a) nessun campo fuori contratto
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stato', 'pronti', 'round', 'roundData', 'risultati',
                       'punteggi', 'prossimaPartita', 'prossimaPartitaCreataDa',
                       'rivincitaAccettataDa', 'rivincitaRifiutataDa',
                       'dataOra', 'timestamp', 'finito', 'confermaVerifica'])

        // (b) `stato` va solo avanti: attesa -> in_corso -> conclusa
        && (
             request.resource.data.stato == resource.data.stato
          || (resource.data.stato == 'attesa'   && request.resource.data.stato == 'in_corso')
          || (resource.data.stato == 'in_corso' && request.resource.data.stato == 'conclusa')
        )

        // (c) `round` non diminuisce e cresce al massimo di 1
        && rnd(request.resource.data) >= rnd(resource.data)
        && rnd(request.resource.data) <= rnd(resource.data) + 1

        // (d) `risultati` e' APPEND-ONLY: un esito congelato non si modifica
        //     ne' si rimuove (e' cio' che impedisce il doppio punteggio)
        && (
             !('risultati' in request.resource.data.diff(resource.data).affectedKeys())
          || (
               arr(request.resource.data, 'risultati').size() >= arr(resource.data, 'risultati').size()
            && arr(request.resource.data, 'risultati').size() <= arr(resource.data, 'risultati').size() + 1
            && arr(resource.data, 'risultati').hasOnly(arr(request.resource.data, 'risultati'))
             )
        )

        // (e) `punteggi` cambia solo quando cambiano `risultati`, oppure alla
        //     chiusura della partita (ultimo round: totali ricontrollati)
        && (
             !('punteggi' in request.resource.data.diff(resource.data).affectedKeys())
          || 'risultati' in request.resource.data.diff(resource.data).affectedKeys()
          || (resource.data.stato == 'in_corso' && request.resource.data.stato == 'conclusa')
        )

        // (f) `roundData`: tre soli casi leciti
        //       1. avvio partita:      (assente) -> r1 / compilazione / v1
        //       2. stesso round:       stessa fase e stessa versione,
        //                              oppure fase avanti di un passo e v+1
        //       3. round successivo:   rN -> r(N+1) / compilazione / v1
        && (
             !('roundData' in request.resource.data.diff(resource.data).affectedKeys())
          || (
               !('roundData' in resource.data)                                   // caso 1
            && rnd(request.resource.data) == 1
            && roundCoerente(request.resource.data.roundData)
            && request.resource.data.roundData.fase == 'compilazione'
            && request.resource.data.roundData.faseVersion == 1
            && request.resource.data.roundData.esitoId == null
             )
          || (
               'roundData' in resource.data                                       // casi 2 e 3
            && roundCoerente(request.resource.data.roundData)
            && (
                 request.resource.data.roundData.round == resource.data.roundData.round + 1   // caso 3
              && request.resource.data.roundData.fase == 'compilazione'
              && request.resource.data.roundData.faseVersion == 1
              && request.resource.data.roundData.esitoId == null
               )
            || (
                 request.resource.data.roundData.round == resource.data.roundData.round        // caso 2
              && request.resource.data.roundData.lettera == resource.data.roundData.lettera
              // il QUORUM del round non si tocca: ne' chi esce, ne' chi entra
              && request.resource.data.roundData.partecipanti == resource.data.roundData.partecipanti
              && (
                   (
                     request.resource.data.roundData.fase == resource.data.roundData.fase
                  && request.resource.data.roundData.faseVersion == resource.data.roundData.faseVersion
                   )
                || (
                     request.resource.data.roundData.faseVersion
                       == resource.data.roundData.faseVersion + 1
                  && (
                       (resource.data.roundData.fase == 'compilazione'
                        && request.resource.data.roundData.fase == 'revisione')
                    || (resource.data.roundData.fase == 'revisione'
                        && request.resource.data.roundData.fase == 'risultati')
                     )
                  // l'esito si congela una volta sola e non si toglie piu'
                  && (resource.data.roundData.esitoId == null
                      || request.resource.data.roundData.esitoId == resource.data.roundData.esitoId)
                   )
               )
             )
        )

        // (g) le conferme restano una lista
        && (
             !('roundData' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.roundData.conferme is list
        );

      // ------------------------------------------------- risposte (privacy)

      match /risposte/{docId} {

        function idValido() { return docId.matches('^r[0-9]{1,2}__p[0-7]$'); }

        function struttura(d) {
          return idValido()
            && intero(d.round, 1, 10)
            && d.roundId == 'r' + string(d.round)
            && stringa(d.giocatore, 40)
            && intero(d.indice, 0, 7)
            && d.categorie is list
            && d.risposte is map;
        }

        // LETTURA del proprio documento. [RICHIEDE AUTH]
        // Il confronto e' sul nome dichiarato dal client: non e' un'identita',
        // quindi e' una dichiarazione di intento, non una garanzia.
        allow get: if request.auth != null
                   && resource != null
                   && resource.data.giocatore == request.auth.token.nome;

        // LETTURA dell'elenco del round (la query `where('round','==',N)`
        // aperta solo in revisione). Le regole non possono verificare che chi
        // legge partecipi al round senza una get() sul documento padre,
        // vietata dal vincolo di progetto: l'isolamento reale in compilazione
        // viene dal CLIENT, che non apre questa query (verificato in
        // tests/ncc/quota.test.js), non da questa regola. [RICHIEDE AUTH]
        allow list: if request.auth != null;

        allow delete: if false;

        // CREAZIONE del proprio documento. [RICHIEDE AUTH]
        // La fase di compilazione non e' verificabile qui senza leggere il
        // documento padre: l'autoconsistenza (id, round, indice, categorie)
        // resta controllata, e i campi identitari diventano immutabili.
        allow create: if struttura(request.resource.data)
                      && request.auth != null
                      && request.resource.data.giocatore == request.auth.token.nome;

        // AGGIORNAMENTO parziale sulle sole celle. [RICHIEDE AUTH]
        allow update: if struttura(request.resource.data)
          && resource.data.round == request.resource.data.round
          && resource.data.roundId == request.resource.data.roundId
          && resource.data.indice == request.resource.data.indice
          && resource.data.categorie == request.resource.data.categorie
          && resource.data.giocatore == request.resource.data.giocatore
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['risposte', 'aggiornato', 'categorie'])
          && request.resource.data.risposte.keys().hasOnly(
               ['c0', 'c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8', 'c9'])
          && request.auth != null
          && resource.data.giocatore == request.auth.token.nome;
      }
    }

    // --------------------------------------------------- override dizionario

    match /config/dizionario {
      allow read: if true;          // parole aggiunte/escluse: non riservato
      allow write: if false;        // manutenzione manuale via console
    }
  }
}

// =============================================================================
// CHECKLIST RIPRODUCIBILE (serve la CLI Firebase; qui NON eseguita)
// =============================================================================
//
//   1. npm i -D firebase-tools
//   2. npx firebase init firestore      (progetto funatwork-cd237;
//                                        regole: firestore.rules; niente indici)
//   3. cp games/nomi-cose-citta/firestore.rules.proposed firestore.rules
//   4. npx firebase emulators:start --only firestore,auth
//   5. Verifiche, con due schede in incognito sulla partita creata dall'hub:
//        a) partita completa a 2 giocatori senza errori di permesso
//           (lobby, compilazione, STOP, revisione, esito, classifica);
//        b) console: saltare 'revisione' scrivendo 'roundData.fase'
//           direttamente a 'risultati'                 → RIFIUTATO;
//        c) console: decrementare 'roundData.faseVersion'  → RIFIUTATO;
//        d) console: modificare o rimuovere un esito in `risultati[]`
//                                                          → RIFIUTATO;
//        e) console: scrivere `punteggi` a mano             → RIFIUTATO;
//        f) console: ridurre `roundData.partecipanti` durante la revisione
//                                                          → RIFIUTATO;
//        g) console: scrivere sul documento risposte di un altro giocatore
//                                                          → RIFIUTATO (con Auth);
//        h) allenamento solo: zero richieste nel pannello Network.
//   6. Solo dopo: `npx firebase deploy --only firestore:rules`.
//
// AVVERTENZA: il blocco `match /partite/{matchId}` copre TUTTI i giochi FaW.
// Le clausole qui sono scritte per `gioco == 'ncc'` e vanno integrate con
// quelle di Patata/Ruzzle/Pictionary/NeonWar prima di qualsiasi deploy,
// altrimenti si romperebbero gli altri giochi.
